# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Never commit .env.local. Never paste these values into chat or issues.

# Public — safe in the browser. RLS limits this key to reading published templates.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — bypasses RLS. Do NOT prefix with NEXT_PUBLIC_. Set it in your
# hosting provider's environment settings, not in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: separate secret used to hash visitor IPs for rate limiting.
# Falls back to the service role key when empty.
RATE_LIMIT_SALT=

# Optional: canonical site URL for metadata (e.g. https://axora.mn)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
