# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Never commit .env.local. Never paste these values into chat or issues.

# Public — safe in the browser. RLS limits this key to reading published templates.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy key name is supported if your project still uses it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses RLS. Do NOT prefix with NEXT_PUBLIC_. Set it in your
# hosting provider's environment settings, not in client code.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-key

# Server only. Emails the download link when a template payment is confirmed.
# Without these, payment still confirms and the admin sends the link by hand.
# Gmail: SMTP_USER is the address, SMTP_PASSWORD is a 16-character App Password,
# never the account password. Another provider also needs SMTP_HOST.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# EMAIL_FROM=AXORA <no-reply@your-domain.mn>

# Optional: direct Postgres URI used only by scripts/apply-migrations.mjs.
# Supabase Dashboard → Connect → Session pooler URI. Server-only; never expose it.
DATABASE_URL=

# Optional: separate secret used to hash visitor IPs for rate limiting.
# Falls back to the service role key when empty.
RATE_LIMIT_SALT=

# Required for purchase download emails: publicly reachable HTTPS site URL.
# Localhost works for metadata only; it cannot be emailed as a customer download URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development only: allow emailed localhost links for testing on this computer.
# Never use this for real customers on other devices.
# ALLOW_LOCAL_DOWNLOAD_LINKS=true

# Ecosystem integration: all values below are SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# HTTPS application origins/base URLs; generate independent tokens of at least 32 characters.
AXORA_FACTORY_URL=
AXORA_FACTORY_ADMIN_TOKEN=
AXORA_DASHBOARD_URL=
AXORA_DASHBOARD_SERVICE_TOKEN=
AXORA_DASHBOARD_BILLING_TOKEN=
AXORA_ECOSYSTEM_JOB_SECRET=
# Custom HTTP payment bridge (not a preconfigured QPay integration).
AXORA_PAYMENT_API_URL=
AXORA_PAYMENT_API_TOKEN=
AXORA_PAYMENT_MERCHANT_ID=
AXORA_PAYMENT_WEBHOOK_SECRET=
# Test-only loopback HTTP allowance. Keep disabled in production.
AXORA_INTEGRATION_LOCAL_TEST=0
# Optional isolated build directory for QA; normally leave unset.
# AXORA_DIST_DIR=.next-ecosystem-qa
